<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Company>SsdVirtual</Company>
    <Product>SsdVirtual</Product>
    <Copyright>Copyright (c) 2026 SsdVirtual contributors</Copyright>
    <Deterministic>true</Deterministic>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- CA1416: platform compatibility is guaranteed (Windows-only product). -->
    <NoWarn>$(NoWarn);CA1416;NU1603;NU1701;CS1591</NoWarn>
  </PropertyGroup>
</Project>
