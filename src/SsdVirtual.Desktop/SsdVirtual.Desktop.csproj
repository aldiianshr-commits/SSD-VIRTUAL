<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>SsdVirtual.Desktop</RootNamespace>
    <AssemblyName>SsdVirtual</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms both define Application/MessageBox/...; explicit usings avoid ambiguity. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>Assets\SsdVirtual.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SsdVirtual.Core\SsdVirtual.Core.csproj" />
    <ProjectReference Include="..\SsdVirtual.GoogleDrive\SsdVirtual.GoogleDrive.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" />
    <Resource Include="Assets\SsdVirtual.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>
</Project>
